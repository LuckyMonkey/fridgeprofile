# Runtime output from ad hoc local runs.
server_profile_*.txt

# Local credentials and state must stay out of the backup repo.
.codex/auth.json
.codex/history.jsonl
.codex/*.sqlite
.codex/*.sqlite-shm
.codex/*.sqlite-wal
.codex/cache/
.codex/sessions/
.codex/tmp/
.codex/.tmp/
*.pem
*.key
*.token
*.secret
*.env

# Binary backup payloads are kept outside GitHub; publish text-safe .b64
# artifacts when a connector cannot push normal git objects.
infra/archives/*.tar
infra/archives/*.tar.gz
infra/archives/*.tar.zst
generated/
